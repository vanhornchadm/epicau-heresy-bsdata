<catalogue id="5cf7-d880-4af1-62f1" name="EpicAU - Daemons Of The Ruinstorm" revision="5" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="9" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="77f9-aab5-0ff4-5947" name="Daemons Of The Ruinstorm" hidden="false">
      <rules>
        <rule id="6585-3fd2-c365-8c1e" name="Army List" hidden="false">
          <description>Strategy Rating 2. Formation initiative 2+.
One Followers of Chaos detachment (same god or Undivided) may be taken per Daemonic Horde.
0-1 Greater Daemon Horde per god-affiliated Daemonic Horde of the same god.
Daemonic Hordes and Followers of Chaos may take any number of Gifts of Chaos, each once per detachment.
Allied units may only come from one other army list; allied Lords of War may be freely chosen.
Up to 1/3 of the army's points may be spent on Allies and Lords of War.
Berserk formations cannot claim objectives in the GT scenario.
Cohesive allies: Legion Astartes (Traitor Legions), Solar Auxilia, Imperial Militia (Traitor Militia).
Disruptive allies: Mechanicum Taghmata, Legio Titanicus, Knight Household.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="406b-99e0-4adf-c131" name="Allies" hidden="false" targetId="d6db-799f-23f8-2194" type="rule"/>
