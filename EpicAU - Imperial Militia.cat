      <costs>
        <cost name="pts" typeId="points" value="75.0"/>
      </costs>
    </selectionEntry>
  </sharedSelectionEntries>
  <sharedRules>
    <rule id="a5f3-4f14-5cc2-8909" name="Critical Hit (Auxilia Baneblade)" hidden="false">
      <description>Destroyed. any units within 5cm of the model suffer a hit on a roll of 6+.</description>
    </rule>
    <rule id="197c-117b-f456-b8fc" name="Critical Hit (Auxilia Gorgon)" hidden="false">
      <description>The Gorgon is immobilised and D6 infantry units inside the Gorgon take a hit. Further Critical Hits destroy the Gorgon.</description>
    </rule>
    <rule id="913c-8006-a6f4-b598" name="Critical Hit (Auxilia Stormhammer)" hidden="false">
      <description>Destroyed. any units within 5cm of the model suffer a hit on a roll of 6+.</description>
    </rule>
    <rule id="1501-61e2-ff5b-e8f6" name="Slow and Steady (Emperor Class Battleship)" hidden="false">
      <description>May not be used on the first two turns of a battle unless the scenario specifically says otherwise.</description>
    </rule>
    <rule id="669f-3540-09dc-f8b5" name="Special Rules (Militia Auxiliary)" hidden="false">
      <description>Additional Militia Auxiliary units added to a formation must use the same weapon type.</description>
    </rule>
    <rule id="cba6-5793-2d21-6f75" name="Transport (Arvus Lighter Orbital Shuttle)" hidden="false">
      <description>May carry two infantry units. Ogryn Brute Squads count as two units.</description>
    </rule>
    <rule id="2cf5-176e-0401-72b2" name="Transport (Auxilia Gorgon)" hidden="false">
      <description>May carry 8 INF units. Ogryn Brute Squads count as 2 units.</description>
    </rule>
    <rule id="d816-1f0c-1122-efb4" name="Transport (Auxilia Rhino)" hidden="false">
      <description>May carry 2 INF units. Ogryn Brute Squads count as 2 units.</description>
    </rule>
    <rule id="8734-e539-115f-b7b6" name="Transport (Dauntless Class Light Cruiser)" hidden="false">
      <description>May carry up to 20 of the following units and as many Arvus Lighter Orbital Shuttles required to transport them: Force Commander, Militia Auxiliaries, Levy Auxiliaries, Militia Grenadiers, Miltia Fire Support Squads, Ogryn Brute Squad or Auxilia Rapier Platforms.</description>
    </rule>
    <rule id="dd39-e82e-1a99-d7b0" name="Transport (Emperor Class Battleship)" hidden="false">
      <description>May carry up to 60 of the following units and as many Arvus Lighter Orbital Shuttles required to transport them: Force Commander, Militia Auxiliaries, Levy Auxiliaries, Militia Grenadiers, Miltia Fire Support Squads, Ogryn Brute Squad or Auxilia Rapier Platforms.</description>
    </rule>
    <rule id="3d72-7cfe-f2fe-1488" name="Transport (Land Raider Proteus)" hidden="false">
      <description>May carry 2 INF units. Ogryn Brute Squads count as 2 units.</description>
    </rule>
  </sharedRules>
