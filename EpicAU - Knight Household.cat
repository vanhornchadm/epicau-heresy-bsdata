              </constraints>
              <rules>
                <rule id="d711-1093-c8bd-5f1c" name="Expanded Armoury" hidden="false">
                  <description>Upgrade 1 or more units in this formation: Questorius Knight-Paladin or Questorius Knight-Errant to Questorius Knight-Warden (+25 pts each); Questorius Knight-Paladin or Questorius Knight-Errant to Questorius Knight-Styrix (+25 pts each); Questorius Knight-Paladin or Questorius Knight-Errant to Questorius Knight-Crusader (+25 pts each); Questorius Knight-Paladin or Questorius Knight-Errant to Questorius Knight-Gallant (+25 pts each); Questorius Knight-Paladin or Questorius Knight-Errant to Questorius Knight-Magaera (+25 pts each). Once this upgrade is taken, the upgraded units appear in the formation and the Raise the Banners upgrade, next to the units they replace; pick them there.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
              </costs>
            </selectionEntry>
