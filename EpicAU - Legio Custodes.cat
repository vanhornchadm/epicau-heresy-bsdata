<catalogue id="7e58-c014-c5e4-5c80" name="EpicAU - Legio Custodes" revision="10" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="16" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="6d49-ab7e-2c53-847a" name="Legio Custodes" hidden="false">
      <rules>
        <rule id="896b-a634-9581-a375" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
Each upgrade may only be taken once per detachment.
Up to 1/2 of the army's points may be spent on Allies and/or Lords of War.
The wiki gives the strategy rating as "1+", which appears to be a typo; Departmento Munitorum uses 5.
The wiki does not list which armies are cohesive or disruptive allies for Legio Custodes.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4de7-d815-5d6f-71d0" name="The Emperor's Chosen" hidden="false" targetId="262a-595f-46af-5c10" type="rule"/>
        <infoLink id="68e2-980a-0f59-4f56" name="Allies" hidden="false" targetId="d6db-799f-23f8-2194" type="rule"/>
      </infoLinks>
