  <sharedRules>
    <rule id="0791-e4e7-e587-e624" name="Corvus Assault Pod notes" hidden="false">
      <description>Notes: FxF. Transport. May carry 10 infantry units. Terminators, Breachers, Thallax, Ursarax, Myrmidon take up 2 spaces each.</description>
    </rule>
    <rule id="19b0-5987-ad29-97d6" name="Corvus Assault Pod notes" hidden="false">
      <description>Notes: Fwd. Transport. May carry 10 infantry units. Terminators, Breachers, Thallax, Ursarax, Myrmidon take up 2 spaces each.</description>
    </rule>
    <rule id="ed91-8491-4429-544c" name="Critical Hit (Imperator Support Titan (experimental))" hidden="false">
      <description>Roll a D6 in the end phase for the remainder of the game, on a 1, the Titan's reactor explodes, destroying it completely and hitting all units within 5cm on a standard 4+ to hit, on a 2-3, the Titan loses a point of DC, 4-6 the reactor is repaired.</description>
    </rule>
    <rule id="5f22-57f6-02e3-5921" name="Critical Hit (Reaver Battle Titan)" hidden="false">
      <description>Roll a D6 in the end phase for the remainder of the game, on a 1, the Titan's reactor explodes, destroying it completely and hitting all units within 5cm on a standard 6+ to hit, on a 2-3, the Titan loses a point of DC, 4-6 the reactor is repaired.</description>
    </rule>
    <rule id="ef58-27fe-2af7-e9d8" name="Critical Hit (Warbringer Nemesis Titan*)" hidden="false">
      <description>Roll a D6 in the end phase for the remainder of the game, on a 1, the Titan's reactor explodes, destroying it completely and hitting all units within 5cm on a standard 4+ to hit, on a 2-3, the Titan loses a point of DC, 4-6 the reactor is repaired.</description>
    </rule>
    <rule id="a735-f830-81c2-d8a7" name="Critical Hit (Warhound Scout Titan)" hidden="false">
      <description>The Warhound staggers D6cm in a random direction taking an additional DC, any units that come into base contact with the Warhound as it staggers take a standard hit on a 6+.</description>
    </rule>
    <rule id="e1be-4cff-2b2b-52c6" name="Critical Hit (Warlord Battle Titan)" hidden="false">
      <description>Roll a D6 in the end phase for the remainder of the game, on a 1, the Titan's reactor explodes, destroying it completely and hitting all units within 5cm on a standard 4+ to hit, on a 2-3, the Titan loses a point of DC, 4-6 the reactor is repaired.</description>
    </rule>
    <rule id="8539-e5e4-7f2a-4e4b" name="Critical Hit (Warmaster Heavy Battle Titan*)" hidden="false">
      <description>Roll a D6 in the end phase for the remainder of the game, on a 1, the Titan's reactor explodes, destroying it completely and hitting all units within 5cm on a standard 4+ to hit, on a 2-3, the Titan loses a point of DC, 4-6 the reactor is repaired.</description>
    </rule>
    <rule id="79c4-0356-ec55-8f08" name="Critical Hit (Warmonger Support Titan (experimental))" hidden="false">
      <description>Roll a D6 in the end phase for the remainder of the game, on a 1, the Titan's reactor explodes, destroying it completely and hitting all units within 5cm on a standard 4+ to hit, on a 2-3, the Titan loses a point of DC, 4-6 the reactor is repaired.</description>
    </rule>
    <rule id="4566-4746-11a4-d316" name="Placeholder (Dire Wolf Heavy Scout Titan*)" hidden="false">
      <description>Stats to be written.</description>
    </rule>
    <rule id="aa77-fa30-4196-3fb8" name="Placeholder (Warlord-Sinister Battle Titan*)" hidden="false">
      <description>Stats to be written.</description>
    </rule>
    <rule id="091c-c438-ec85-df9a" name="Placeholder (Warmaster Iconoclast Titan*)" hidden="false">
      <description>Stats to be written.</description>
    </rule>
    <rule id="0a85-b554-92d5-e187" name="Special Rules (Imperator Support Titan (experimental))" hidden="false">
      <description>Secondary Targeting Protocols.</description>
    </rule>
    <rule id="d48e-55d4-a3b0-58f1" name="Special Rules (Warmonger Support Titan (experimental))" hidden="false">
      <description>Secondary Targeting Protocols.</description>
    </rule>
    <rule id="387e-6e2c-75a2-1e5d" name="Support Missile notes" hidden="false">
      <description>Notes: Warhead, One-shot; Vortex: 3 BP, MW, TK(1), Ignore Cover; Warp: MW2+, TK(D3); Deathstrike: MW2+, TK(D6); Barrage: 10 BP, DIsrupt, FxF. carapace only; Warp missiles ignore enemy shields.</description>
    </rule>
    <rule id="9b1f-953c-13dc-ff19" name="Titan Movement" hidden="false">
      <description>May step over impassable terrain or dangerous terrain that is lower than the titan's knees and no greater than 2cm wide.</description>
    </rule>
