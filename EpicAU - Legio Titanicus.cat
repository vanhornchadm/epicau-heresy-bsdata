        <characteristic name="CC" typeId="720d-edd1-f5f0-6a73">4+</characteristic>
        <characteristic name="FF" typeId="6aea-f6b7-e754-4fea">4+</characteristic>
        <characteristic name="Weapons" typeId="8053-23b9-7271-666e">Ardex Mega-Bolters&lt;BR&gt;&lt;BR&gt;1 x Dire Wolf Weapon</characteristic>
        <characteristic name="Range" typeId="3069-85d5-1a17-f28e">30cm&lt;BR&gt;&lt;BR&gt;-</characteristic>
        <characteristic name="Firepower" typeId="8397-b72d-83b9-ce5f">4 x AP4+/AT6+&lt;BR&gt;&lt;BR&gt;1 x Carapace</characteristic>
        <characteristic name="Weapon Notes" typeId="a2db-1347-a5a5-688a">-&lt;BR&gt;&lt;BR&gt;Fixed Forward</characteristic>
        <characteristic name="Notes" typeId="b1b3-f018-48be-a953">Fearless, Reinforced Armour, Walker, Cortex Controller, Infiltrator. May step over impassable terrain or dangerous terrain that is lower than the titan's knees and no greater than 2cm wide. (Fan-made, not part of EpicAU: converted from Legions Imperialis against the EpicAU Warhound.)</characteristic>
        <characteristic name="Damage Capacity" typeId="4829-b112-1d5a-a2af">3</characteristic>
        <characteristic name="Void Shields" typeId="008c-819b-8cb1-5aad">2</characteristic>
        <characteristic name="Critical Hit" typeId="1acb-7796-a6da-6469">The Titan staggers D6cm in a random direction taking an additional DC, any units that come into base contact with it as it staggers take a standard hit on a 6+.</characteristic>
      </characteristics>
    </profile>
