    <profile id="fb55-6cba-fdc1-da63" name="Dire Wolf Heavy Scout Titan*" hidden="false" typeId="a3a4-6088-7144-07b6" typeName="War Engine">
      <characteristics>
        <characteristic name="Type" typeId="060e-c5b1-5155-b844">WE</characteristic>
        <characteristic name="Speed" typeId="f5e6-b542-20ce-5e5f">30cm</characteristic>
