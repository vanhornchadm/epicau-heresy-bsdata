    <profile id="887a-83e6-e01e-11bc" name="Imperator Support Titan (experimental)" hidden="false" typeId="a3a4-6088-7144-07b6" typeName="War Engine">
      <characteristics>
        <characteristic name="Type" typeId="060e-c5b1-5155-b844">WE</characteristic>
        <characteristic name="Speed" typeId="f5e6-b542-20ce-5e5f">15cm</characteristic>
        <characteristic name="Armour" typeId="4dec-9e47-21ab-b418">4+</characteristic>
        <characteristic name="CC" typeId="720d-edd1-f5f0-6a73">4+</characteristic>
        <characteristic name="FF" typeId="6aea-f6b7-e754-4fea">3+</characteristic>
        <characteristic name="Weapons" typeId="8053-23b9-7271-666e">Plasma Annihilator&lt;BR&gt;&lt;BR&gt;Hellstorm Cannon&lt;BR&gt;&lt;BR&gt;Defense Laser&lt;BR&gt;&lt;BR&gt;4x Battle Cannons&lt;BR&gt;&lt;BR&gt;Quake Cannon&lt;BR&gt;&lt;BR&gt;Tertiary armament&lt;BR&gt;&lt;BR&gt;Leg Bastions</characteristic>
        <characteristic name="Range" typeId="3069-85d5-1a17-f28e">90cm&lt;BR&gt;&lt;BR&gt;60cm&lt;BR&gt;&lt;BR&gt;90cm&lt;BR&gt;&lt;BR&gt;75cm&lt;BR&gt;&lt;BR&gt;90cm&lt;BR&gt;&lt;BR&gt;(15cm)&lt;BR&gt;&lt;BR&gt;-</characteristic>
        <characteristic name="Firepower" typeId="8397-b72d-83b9-ce5f">4x MW2+&lt;BR&gt;&lt;BR&gt;10BP&lt;BR&gt;&lt;BR&gt;MW2+/AA4+ TK(D3)&lt;BR&gt;&lt;BR&gt;AP4+/AT4+&lt;BR&gt;&lt;BR&gt;3BP&lt;BR&gt;&lt;BR&gt;(small arms)&lt;BR&gt;&lt;BR&gt;Counts as a Corvus Assault Pod</characteristic>
        <characteristic name="Weapon Notes" typeId="a2db-1347-a5a5-688a">TK(D3), Slow Firing, Fwd&lt;BR&gt;&lt;BR&gt;Fwd&lt;BR&gt;&lt;BR&gt;-&lt;BR&gt;&lt;BR&gt;-&lt;BR&gt;&lt;BR&gt;MW, FxF&lt;BR&gt;&lt;BR&gt;EA(+2)&lt;BR&gt;&lt;BR&gt;-</characteristic>
        <characteristic name="Notes" typeId="b1b3-f018-48be-a953">Cortex Controller, Fearless, Inspiring, Reinforced Armour, Walker, Secondary Targeting Protocols. May step over impassable terrain or dangerous terrain that is lower than the titan's knees and no greater than 2cm wide.</characteristic>
        <characteristic name="Damage Capacity" typeId="4829-b112-1d5a-a2af">12</characteristic>
        <characteristic name="Void Shields" typeId="008c-819b-8cb1-5aad">8</characteristic>
        <characteristic name="Critical Hit" typeId="1acb-7796-a6da-6469">Roll a D6 in the end phase for the remainder of the game, on a 1, the Titan's reactor explodes, destroying it completely and hitting all units within 5cm on a standard 4+ to hit, on a 2-3, the Titan loses a point of DC, 4-6 the reactor is repaired.</characteristic>
      </characteristics>
    </profile>
