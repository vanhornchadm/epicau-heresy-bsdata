<catalogue id="eef9-28e8-413a-a932" name="EpicAU - Legion Astartes - Alpha Legion" revision="1" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="7c68-5795-4afd-d03a" name="Legion Astartes - Alpha Legion" hidden="false">
      <rules>
        <rule id="4f6e-951f-b20b-e2d9" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Legio Titanicus, Imperial Militia, Solar Auxilia, Mechanicum Taghmata, Knight Household.
Disruptive allies: Daemons Of The Ruinstorm.</description>
        </rule>
      </rules>
      <infoLinks>
