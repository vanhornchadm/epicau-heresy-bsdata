<catalogue id="ffd4-dc4d-146f-0a4a" name="EpicAU - Legion Astartes - Blood Angels" revision="1" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="c97f-2d11-f5f9-e543" name="Legion Astartes - Blood Angels" hidden="false">
      <rules>
        <rule id="9138-171e-a64c-ef56" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Mechanicum Taghmata, Legio Titanicus, Legio Custodes.
Disruptive allies: Imperial Militia, Solar Auxilia, Knight Household.</description>
        </rule>
      </rules>
