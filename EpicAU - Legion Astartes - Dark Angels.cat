<catalogue id="bfce-126c-14cf-2e49" name="EpicAU - Legion Astartes - Dark Angels" revision="4" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="4" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="039f-62fd-6054-1990" name="Legion Astartes - Dark Angels" hidden="false">
      <rules>
        <rule id="338e-7aa0-ae61-b0c3" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Legio Titanicus, Solar Auxilia, Legio Custodes.
Disruptive allies: Imperial Militia, Knight Household, Mechanicum Taghmata.</description>
        </rule>
      </rules>
