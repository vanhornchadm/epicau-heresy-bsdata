          <selectionEntryGroups>
            <selectionEntryGroup id="3af8-95be-2f1a-c2a5" name="Standard Transport / Drop Assault / Assault Claw" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a3a7-8448-ccb4-7900" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="205b-0648-5900-41ec" name="Standard Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a2cb-1090-190a-41f7" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="e39f-cbc2-4ba1-f2db" name="Standard Transport" hidden="false">
                      <description>Add enough Rhino Armoured Carriers to transport the entire formation after all other upgrades are chosen. Each Rhino carries 2 Tactical-sized units; one of them may be a Damocles Command Rhino. The count is set from the formation; add this upgrade last, or adjust the transports if you change units afterwards.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="5a94-3c5c-ecd5-bc76" name="Transports" hidden="false" collective="false" import="true" defaultSelectionEntryId="115b-9368-6f4d-1f7f">
                      <modifiers>
                        <modifier type="increment" field="203b-2eae-cb18-9a05" value="1">
                          <repeats>
                            <repeat field="selections" scope="a481-4940-9b05-ba1a" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="dca3-6748-53f0-e4bb" repeats="1" roundUp="true"/>
                          </repeats>
                        </modifier>
