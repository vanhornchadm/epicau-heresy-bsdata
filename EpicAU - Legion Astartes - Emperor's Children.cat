<catalogue id="5f9a-ba50-3911-92f6" name="EpicAU - Legion Astartes - Emperor's Children" revision="3" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="3" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="1c64-e6d8-8f0e-7453" name="Legion Astartes - Emperor's Children" hidden="false">
      <rules>
        <rule id="3c48-1e54-bde4-73e6" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Legio Titanicus, Daemons Of The Ruinstorm (Slaanesh).
Disruptive allies: Imperial Militia, Solar Auxilia, Knight Household, Mechanicum Taghmata.</description>
        </rule>
      </rules>
