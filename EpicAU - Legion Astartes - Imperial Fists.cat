          <selectionEntryGroups>
            <selectionEntryGroup id="1e63-2067-cf64-d5cf" name="Standard Transport / Drop Assault / Assault Claw" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2fe5-d307-2d60-620c" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="cb48-d278-523b-63fa" name="Standard Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dca6-b273-5c9e-5aed" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="57dd-8a19-5101-000f" name="Standard Transport" hidden="false">
                      <description>Add enough Rhino Armoured Carriers to transport the entire formation after all other upgrades are chosen. Each Rhino carries 2 Tactical-sized units; one of them may be a Damocles Command Rhino. The count is set from the formation; add this upgrade last, or adjust the transports if you change units afterwards.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="c39d-72bf-93f1-bbb4" name="Transports" hidden="false" collective="false" import="true" defaultSelectionEntryId="781c-1ccf-ebc5-f684">
                      <modifiers>
                        <modifier type="increment" field="6142-05ce-b76e-09c9" value="1">
                          <repeats>
                            <repeat field="selections" scope="fd1f-77e1-4c8c-205d" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="dca3-6748-53f0-e4bb" repeats="1" roundUp="true"/>
                          </repeats>
                        </modifier>
