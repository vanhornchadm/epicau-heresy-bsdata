<catalogue id="8274-46a9-4a3e-64a9" name="EpicAU - Legion Astartes - Imperial Fists" revision="3" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="3" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="a4bd-1a95-19e5-c4d8" name="Legion Astartes - Imperial Fists" hidden="false">
      <rules>
        <rule id="f13e-ba21-5cda-77b4" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Imperial Militia, Solar Auxilia, Knight Household, Mechanicum Taghmata, Legio Titanicus, Legio Custodes.
Disruptive allies: none.</description>
        </rule>
      </rules>
      <infoLinks>
