<catalogue id="eddb-484c-4e15-f554" name="EpicAU - Legion Astartes - Iron Hands" revision="2" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="2" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="22d0-3111-151a-71fd" name="Legion Astartes - Iron Hands" hidden="false">
      <rules>
        <rule id="127f-6fa3-8517-a4dc" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Legio Titanicus, Mechanicum Taghmata, Knight Household, Legio Custodes.
Disruptive allies: Imperial Militia, Solar Auxilia.</description>
        </rule>
      </rules>
