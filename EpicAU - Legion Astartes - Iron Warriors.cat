              </constraints>
              <rules>
                <rule id="2f13-4b56-36e6-16ea" name="Armoury Assets" hidden="false">
                  <description>Upgrade 1-2 units in this formation: Land Raider Phobos or Land Raider Proteus to Land Raider Achilles (+25 pts each); Vindicator to Vindicator Laser Destroyer (+20 pts each); Predator to Predator Infernus (+20 pts each); Predator to Predator Executioner (+20 pts each); Predator to Whirlwind Scorpius (+20 pts each). Once this upgrade is taken, the upgraded units appear in the Heavy Transport upgrade and the Tank upgrade, next to the units they replace; pick them there.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup id="f31c-93a7-7c53-e5a1" name="Heavy Transport / Teleport / Assault Ram" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8d42-6c56-f260-00d8" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="9591-1afe-7c7f-bd3f" name="Heavy Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="00a5-97e2-5f33-f043" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="96c2-a00a-fdac-8978" name="Heavy Transport" hidden="false">
                      <description>Add enough transports to carry the entire formation.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="6ebb-095a-a4f9-87eb" name="Transport" hidden="false" collective="false" import="true" defaultSelectionEntryId="1913-bb29-fc50-cd99">
                      <constraints>
                        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7b64-3079-7b77-e047" type="min"/>
                        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c8c4-ba95-211b-bfc1" type="max"/>
                      </constraints>
                      <selectionEntries>
                        <selectionEntry id="1913-bb29-fc50-cd99" name="Land Raider Phobos" hidden="false" collective="false" import="true" type="upgrade">
                          <constraints>
                            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1480-144f-e9a5-c4d0" type="max"/>
                          </constraints>
                          <selectionEntries>
                            <selectionEntry id="77f4-66fc-0a8e-37b9" name="Land Raider Phobos" hidden="false" collective="false" import="true" type="model">
