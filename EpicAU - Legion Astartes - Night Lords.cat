                        <modifier type="increment" field="b6ea-d2fc-e4b9-a732" value="1">
                          <repeats>
                            <repeat field="selections" scope="af06-84a3-2610-5ad3" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="dca3-6748-53f0-e4bb" repeats="1" roundUp="true"/>
                          </repeats>
