<catalogue id="83d5-caad-e2f9-7809" name="EpicAU - Legion Astartes - Salamanders" revision="2" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="2" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="5c7a-5e1b-972b-b1d6" name="Legion Astartes - Salamanders" hidden="false">
      <rules>
        <rule id="bf45-49c5-8f6a-c8b0" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Solar Auxilia, Legio Titanicus, Legio Custodes.
Disruptive allies: Imperial Militia, Knight Household, Mechanicum Taghmata.</description>
        </rule>
      </rules>
