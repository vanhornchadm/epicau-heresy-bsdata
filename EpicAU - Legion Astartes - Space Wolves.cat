<catalogue id="33d5-aeb0-88c2-eb2b" name="EpicAU - Legion Astartes - Space Wolves" revision="1" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="c110-4315-e209-b1a7" name="Legion Astartes - Space Wolves" hidden="false">
      <rules>
        <rule id="d246-ed0d-87d3-01cb" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Legio Titanicus, Legio Custodes.
Disruptive allies: Imperial Militia, Solar Auxilia, Mechanicum Taghmata, Knight Household.</description>
        </rule>
      </rules>
      <infoLinks>
