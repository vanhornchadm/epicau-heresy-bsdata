<catalogue id="ff69-548e-9b5c-5511" name="EpicAU - Legion Astartes - Thousand Sons" revision="4" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="4" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="7c87-4d43-9cd3-c79d" name="Legion Astartes - Thousand Sons" hidden="false">
      <rules>
        <rule id="9055-2a62-d29d-4828" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Legio Titanicus, Daemons Of The Ruinstorm (Tzeentch).
Disruptive allies: Imperial Militia, Solar Auxilia, Mechanicum Taghmata, Knight Household.</description>
        </rule>
      </rules>
