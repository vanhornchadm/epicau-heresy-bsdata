            <selectionEntry id="5df5-75bb-ea75-1f82" name="Armoury Assets" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="9336-0d6d-2c12-823c" value="0">
                  <conditions>
                    <condition field="selections" scope="1107-661d-4d55-b8c7" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1c1a-168c-d3cf-3310" type="lessThan"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9336-0d6d-2c12-823c" type="max"/>
              </constraints>
              <rules>
                <rule id="5893-d1a2-65d2-d5ea" name="Armoury Assets" hidden="false">
                  <description>Upgrade 1-2 units in this formation: Land Raider Phobos or Land Raider Proteus to Land Raider Achilles (+25 pts each); Vindicator to Vindicator Laser Destroyer (+20 pts each); Predator to Predator Infernus (+20 pts each); Predator to Predator Executioner (+20 pts each); Predator to Whirlwind Scorpius (+20 pts each). Once this upgrade is taken, the upgraded units appear in the Heavy Transport upgrade and the Tank upgrade, next to the units they replace; pick them there.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup id="6818-36c8-e0ab-173b" name="Standard Transport / Drop Assault / Heavy Transport" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b579-d28e-0151-7361" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="5354-43e7-ff5d-1075" name="Standard Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7cda-f51e-dd9a-37da" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="bcbd-fb14-3b60-1570" name="Standard Transport" hidden="false">
                      <description>Add enough Rhino Armoured Carriers to transport the entire formation after all other upgrades are chosen. Each Rhino carries 2 Tactical-sized units; one of them may be a Damocles Command Rhino. The count is set from the formation; add this upgrade last, or adjust the transports if you change units afterwards.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="c71b-fb48-775a-49fc" name="Transports" hidden="false" collective="false" import="true" defaultSelectionEntryId="9e08-c950-6be7-6083">
                      <modifiers>
                        <modifier type="increment" field="5bfc-3b31-e243-6f03" value="1">
                          <repeats>
