<catalogue id="03e5-5b1d-fa32-5acb" name="EpicAU - Legion Astartes - White Scars" revision="4" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="4" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="4231-3b39-21b9-e869" name="Legion Astartes - White Scars" hidden="false">
      <rules>
        <rule id="2b7a-04cf-96fc-09f3" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Legio Titanicus, Solar Auxilia, Mechanicum Taghmata, Knight Household, Legio Custodes.
Disruptive allies: Imperial Militia.</description>
        </rule>
      </rules>
