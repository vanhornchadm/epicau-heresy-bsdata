<catalogue id="817a-597c-b385-7eba" name="EpicAU - Legion Astartes - Word Bearers" revision="2" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="2" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="a338-024a-5f83-d99e" name="Legion Astartes - Word Bearers" hidden="false">
      <rules>
        <rule id="ec8e-d84c-4593-00f6" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Cohesive allies: Daemons Of The Ruinstorm, Imperial Militia (Traitor Militia).
Disruptive allies: Legio Titanicus, Mechanicum Taghmata, Knight Household, Solar Auxilia.</description>
        </rule>
      </rules>
      <infoLinks>
