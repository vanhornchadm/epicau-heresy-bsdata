            <selectionEntry id="bad1-ce62-e0d7-7fc3" name="Armoury Assets" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="bac2-d3a9-eeca-941c" value="0">
                  <conditions>
                    <condition field="selections" scope="24b5-f00b-2430-6d64" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1c1a-168c-d3cf-3310" type="lessThan"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bac2-d3a9-eeca-941c" type="max"/>
              </constraints>
              <rules>
                <rule id="fe10-8071-914d-4e11" name="Armoury Assets" hidden="false">
                  <description>Upgrade 1-2 units in this formation: Vindicator to Vindicator Laser Destroyer (+20 pts each); Predator to Predator Infernus (+20 pts each); Predator to Predator Executioner (+20 pts each); Predator to Whirlwind Scorpius (+20 pts each). Once this upgrade is taken, the upgraded units appear in the Tank upgrade, next to the units they replace; pick them there.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup id="fb2a-e70c-00e3-9ef6" name="Standard Transport / Drop Assault" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c76e-d12d-f68d-f053" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="e33e-8702-520c-6c88" name="Standard Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="25dc-7675-37b5-62b3" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="148b-530a-169b-2cbb" name="Standard Transport" hidden="false">
                      <description>Add enough Rhino Armoured Carriers to transport the entire formation after all other upgrades are chosen. Each Rhino carries 2 Tactical-sized units; one of them may be a Damocles Command Rhino. The count is set from the formation; add this upgrade last, or adjust the transports if you change units afterwards.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="67d4-7521-cfe2-b718" name="Transports" hidden="false" collective="false" import="true" defaultSelectionEntryId="3cf2-0670-45df-fe7b">
                      <modifiers>
                        <modifier type="increment" field="11b4-194c-62c0-d694" value="1">
                          <repeats>
                            <repeat field="selections" scope="24b5-f00b-2430-6d64" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="dca3-6748-53f0-e4bb" repeats="1" roundUp="true"/>
                          </repeats>
                        </modifier>
                        <modifier type="increment" field="160c-7d34-8205-e41e" value="1">
                          <repeats>
                            <repeat field="selections" scope="24b5-f00b-2430-6d64" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="dca3-6748-53f0-e4bb" repeats="1" roundUp="true"/>
                          </repeats>
                        </modifier>
                      </modifiers>
                      <constraints>
                        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="11b4-194c-62c0-d694" type="min"/>
                        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="160c-7d34-8205-e41e" type="max"/>
                      </constraints>
