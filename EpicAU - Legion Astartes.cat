            <selectionEntry id="9087-dd7a-23c6-f13f" name="Armoury Assets" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="4197-1a70-5f13-3fa6" value="0">
                  <conditions>
                    <condition field="selections" scope="ebe2-227b-e2b2-0c6d" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1c1a-168c-d3cf-3310" type="lessThan"/>
