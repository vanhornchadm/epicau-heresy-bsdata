              </constraints>
              <selectionEntries>
                <selectionEntry id="56ab-e88a-2d7c-b9bd" name="Standard Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="99f0-3aa0-1e02-d199" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="9c4c-dd0a-52bd-c5ba" name="Standard Transport" hidden="false">
                      <description>Add enough Rhino Armoured Carriers to transport the entire formation after all other upgrades are chosen. Each Rhino carries 2 Tactical-sized units; one of them may be a Damocles Command Rhino. The count is set from the formation; add this upgrade last, or adjust the transports if you change units afterwards.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="7a3a-d674-ba77-87d6" name="Transports" hidden="false" collective="false" import="true" defaultSelectionEntryId="58f3-4b25-d346-c387">
                      <modifiers>
                        <modifier type="increment" field="6c73-c9c4-9248-a8bd" value="1">
                          <repeats>
                            <repeat field="selections" scope="d637-5a8c-a688-97ec" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="dca3-6748-53f0-e4bb" repeats="1" roundUp="true"/>
                          </repeats>
                        </modifier>
                        <modifier type="increment" field="e3a8-4c0a-a909-6027" value="1">
                          <repeats>
                            <repeat field="selections" scope="d637-5a8c-a688-97ec" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="dca3-6748-53f0-e4bb" repeats="1" roundUp="true"/>
                          </repeats>
                        </modifier>
                      </modifiers>
