                    <rule id="0c5a-a43d-10f5-74d8" name="Assault Claw" hidden="false">
                      <description>Add enough Kharybdis Assault Claws to transport the entire formation. Each carries 4 Tactical-sized units, 2 Terminators or 1 Dreadnought; the count is set from the formation.</description>
                    </rule>
                  </rules>
