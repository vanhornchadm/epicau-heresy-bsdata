              </constraints>
              <selectionEntries>
                <selectionEntry id="393e-d674-85a8-19c3" name="Heavy Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b75d-b3c4-629f-317f" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="cc8a-6f37-631b-c3df" name="Heavy Transport" hidden="false">
                      <description>Add enough transports to carry the entire formation. Land Raiders carry 2 Tactical-sized units or 1 Terminator, Spartans twice that and Mastodons four times (Dreadnoughts count as Terminators); the count is set from the formation.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="7527-281d-b9da-2ba3" name="Transport" hidden="false" collective="false" import="true" defaultSelectionEntryId="24eb-7557-a223-aa11">
                      <constraints>
                        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b140-4c31-3e38-e0e3" type="min"/>
                        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="85db-efd7-6e14-fdaf" type="max"/>
                      </constraints>
                      <selectionEntries>
                        <selectionEntry id="24eb-7557-a223-aa11" name="Land Raider Phobos" hidden="false" collective="false" import="true" type="upgrade">
                          <constraints>
                            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3cae-f2d2-19cc-210c" type="max"/>
                          </constraints>
                          <selectionEntryGroups>
                            <selectionEntryGroup id="82fd-a3ee-b47c-28f5" name="Transports" hidden="false" collective="false" import="true" defaultSelectionEntryId="9a0e-3f5b-7615-3010">
                              <modifiers>
                                <modifier type="increment" field="2a46-23bb-ed8a-bbad" value="1">
                                  <repeats>
                                    <repeat field="f52a-9ea6-2bb3-2a37" scope="ebe2-227b-e2b2-0c6d" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="any" repeats="1" roundUp="true"/>
                                  </repeats>
                                </modifier>
