            <selectionEntryGroup id="fb2a-e70c-00e3-9ef6" name="Standard Transport / Drop Assault" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c76e-d12d-f68d-f053" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="e33e-8702-520c-6c88" name="Standard Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="25dc-7675-37b5-62b3" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="148b-530a-169b-2cbb" name="Standard Transport" hidden="false">
                      <description>Add enough Rhino Armoured Carriers to transport the entire formation after all other upgrades are chosen. Each Rhino carries 2 Tactical-sized units; one of them may be a Damocles Command Rhino. The count is set from the formation; add this upgrade last, or adjust the transports if you change units afterwards.</description>
                    </rule>
                  </rules>
