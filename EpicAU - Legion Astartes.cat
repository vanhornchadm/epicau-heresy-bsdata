                <selectionEntry id="0865-0cb0-90e1-568b" name="Heavy Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dfcb-1c75-6b08-68d3" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="d8dd-2354-0a4d-e048" name="Heavy Transport" hidden="false">
                      <description>Add enough transports to carry the entire formation. Land Raiders carry 2 Tactical-sized units or 1 Terminator, Spartans twice that and Mastodons four times (Dreadnoughts count as Terminators); the count is set from the formation.</description>
                    </rule>
