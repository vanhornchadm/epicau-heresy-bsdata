<catalogue id="ecff-e131-e26d-022e" name="EpicAU - Legion Astartes" revision="21" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="14" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="93b4-b1ec-0fbc-b0c8" name="Legion Astartes" hidden="false">
      <rules>
        <rule id="7c71-d57d-93e4-a164" name="Army List" hidden="false">
          <description>Strategy Rating 5. Formation initiative 1+.
3 Support Detachments may be taken per Line Detachment.
A line or support detachment may choose up to four upgrades; each upgrade only once and only one transport option.
Up to 1/3 of the army's points may be spent on Allies and/or Lords of War.
Choose the Legion in the Legion entry; its allies and special formations are listed there. "None" uses the core list only.</description>
        </rule>
      </rules>
