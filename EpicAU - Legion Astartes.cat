                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ad24-4a53-d593-b77e" type="max"/>
              </constraints>
              <rules>
                <rule id="36b5-9e73-fdfc-1d49" name="Sons of Horus" hidden="false">
                  <description>Traitor Legion.
Adds: Destroyer Detachment; Reaver Attack Detachment; Justaerin Terminator Detachment; Horus Lupercal, the Warmaster.
Replaces or removes the core Legion Destroyer Detachment.
Cohesive allies: Legio Titanicus, Imperial Militia, Solar Auxilia.
Disruptive allies: Daemons Of The Ruinstorm, Mechanicum Taghmata, Knight Household.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="299e-504d-5f1a-1ec6" name="Alpha Legion" hidden="false" collective="false" import="true" type="upgrade">
