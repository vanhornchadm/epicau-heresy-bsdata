            <selectionEntry id="470d-6482-1236-a38e" name="Armoury Assets" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="aaf6-4f3b-5983-3fff" value="0">
                  <conditions>
                    <condition field="selections" scope="b27f-15e2-700e-acb0" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1c1a-168c-d3cf-3310" type="lessThan"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="aaf6-4f3b-5983-3fff" type="max"/>
              </constraints>
              <rules>
                <rule id="c454-886a-52d3-8bc3" name="Armoury Assets" hidden="false">
                  <description>Upgrade 1-2 units in this formation: Land Raider Phobos or Land Raider Proteus to Land Raider Achilles (+25 pts each); Vindicator to Vindicator Laser Destroyer (+20 pts each); Predator to Predator Infernus (+20 pts each); Predator to Predator Executioner (+20 pts each); Predator to Whirlwind Scorpius (+20 pts each). Once this upgrade is taken, the upgraded units appear in the Heavy Transport upgrade and the Tank upgrade, next to the units they replace; pick them there.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup id="4dcc-cc83-40e3-ff3b" name="Standard Transport / Drop Assault / Heavy Transport" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b42c-1426-3501-3744" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="a7cc-b3db-06f3-76a5" name="Standard Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="65f1-faed-df6d-9284" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="d71a-163c-3434-723a" name="Standard Transport" hidden="false">
                      <description>Add enough Rhino Armoured Carriers to transport the entire formation after all other upgrades are chosen. Each Rhino carries 2 Tactical-sized units; one of them may be a Damocles Command Rhino. The count is set from the formation; add this upgrade last, or adjust the transports if you change units afterwards.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="b906-6610-874c-3ac4" name="Transports" hidden="false" collective="false" import="true" defaultSelectionEntryId="d16b-8974-a97a-d870">
                      <modifiers>
                        <modifier type="increment" field="9665-667c-bbfd-629a" value="1">
                          <repeats>
                            <repeat field="selections" scope="b27f-15e2-700e-acb0" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="dca3-6748-53f0-e4bb" repeats="1" roundUp="true"/>
                          </repeats>
