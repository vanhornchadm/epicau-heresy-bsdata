    <rule id="dad7-5d43-f2cd-0af1" name="Alpharius &amp; Omegon notes" hidden="false">
      <description>Thick Rear Armour, Fearless, Supreme Commander, Inspiring, Invulnerable Save(4+).</description>
    </rule>
    <rule id="43ed-fcc9-bd20-d641" name="Ammitara Intercessor Squad notes" hidden="false">
      <description>Invulnerable Save(6+). Count as Tactical Marines for transport capacity purposes.</description>
    </rule>
    <rule id="af10-545e-f5c0-0da1" name="Angel Tears Squad notes" hidden="false">
      <description>Count as Assault Marines for transport purposes.</description>
    </rule>
    <rule id="e1d2-fdbe-91e5-8dbf" name="Angron, Master of the World Eaters notes" hidden="false">
      <description>Thick Rear Armour, Fearless, Supreme Commander, Inspiring, Invulnerable Save(6+), Infiltrator.</description>
    </rule>
    <rule id="13f0-9fb5-8d28-f3a1" name="Araknae Weapons Platform* notes" hidden="false">
      <description>An Araknae Weapons Platform must select one weapon system before the start of the game.</description>
    </rule>
    <rule id="ad32-f26e-3482-c173" name="Ascalon* notes" hidden="false">
      <description>Critical Hit: Unit is destroyed and all units within 5cm suffer a standard hit on a 6+</description>
    </rule>
    <rule id="fdab-9176-10a2-403c" name="Attack Bike notes" hidden="false">
      <description>.</description>
    </rule>
