            <selectionEntry id="a00f-8b57-3bee-1105" name="Armoury Assets" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="4f78-f6fd-18d8-988c" value="0">
                  <conditions>
                    <condition field="selections" scope="d637-5a8c-a688-97ec" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1c1a-168c-d3cf-3310" type="lessThan"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4f78-f6fd-18d8-988c" type="max"/>
              </constraints>
              <rules>
                <rule id="8b2c-5745-abb4-0fa9" name="Armoury Assets" hidden="false">
                  <description>Upgrade 1-2 units in this formation: Land Raider Phobos or Land Raider Proteus to Land Raider Achilles (+25 pts each); Vindicator to Vindicator Laser Destroyer (+20 pts each); Predator to Predator Infernus (+20 pts each); Predator to Predator Executioner (+20 pts each); Predator to Whirlwind Scorpius (+20 pts each). Once this upgrade is taken, the upgraded units appear in the Heavy Transport upgrade and the Tank upgrade, next to the units they replace; pick them there.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup id="d1cb-0c7e-8efb-36c1" name="Standard Transport / Drop Assault / Heavy Transport" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4708-7afd-6133-5375" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="56ab-e88a-2d7c-b9bd" name="Standard Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="99f0-3aa0-1e02-d199" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="9c4c-dd0a-52bd-c5ba" name="Standard Transport" hidden="false">
                      <description>Add enough Rhino Armoured Carriers to transport the entire formation after all other upgrades are chosen. Each Rhino carries 2 Tactical-sized units; one of them may be a Damocles Command Rhino. The count is set from the formation; add this upgrade last, or adjust the transports if you change units afterwards.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
