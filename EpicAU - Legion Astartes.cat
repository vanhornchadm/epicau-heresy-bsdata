      <description>Thick Rear Armour, Fearless, Supreme Commander, Inspiring, Invulnerable Save(5+), Infiltrator, Brutal.</description>
    </rule>
    <rule id="78a8-20d4-1963-863b" name="Kratos Heavy Tank* notes" hidden="false">
      <description>A Kratos must select either a Kratos Battlecannon OR Melta Cannon, and either Heavy Bolters OR Lascannons for its hull and for its sponsons, before the start of the game.</description>
    </rule>
    <rule id="3f57-528a-e787-de6c" name="Land Raider Achilles notes" hidden="false">
