          <selectionEntries>
            <selectionEntry id="a31f-fb56-34fd-a2a8" name="None (core list)" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="add" field="category" value="fbc3-4530-e34d-3e92">
                  <conditions>
                    <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="93b4-b1ec-0fbc-b0c8" type="instanceOf"/>
