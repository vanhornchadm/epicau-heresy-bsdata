  <sharedRules>
    <rule id="0b56-850d-a3b4-376c" name="Critical Hit (Ascalon*)" hidden="false">
      <description>Unit is destroyed and all units within 5cm suffer a standard hit on a 6+.</description>
    </rule>
    <rule id="e3e0-54f2-b512-f299" name="Critical Hit (Spartan Assault Tank)" hidden="false">
      <description>Unit is destroyed and all units within 5cm suffer a standard hit on a 6+.</description>
    </rule>
    <rule id="9a78-0401-231a-016b" name="Slow and Steady (Battle Barge)" hidden="false">
      <description>May not be used on the first turn of a battle unless the scenario specifically says otherwise.</description>
    </rule>
    <rule id="b8e0-cd0d-522e-db0e" name="Special Rules (Alpharius &amp; Omegon)" hidden="false">
