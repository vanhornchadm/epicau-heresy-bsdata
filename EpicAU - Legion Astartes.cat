            <selectionEntry id="de07-f53b-190c-f33c" name="Armoury Assets" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="040f-34d7-0940-b100" value="0">
                  <conditions>
                    <condition field="selections" scope="e0d9-a742-05ec-cbb6" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1c1a-168c-d3cf-3310" type="lessThan"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="040f-34d7-0940-b100" type="max"/>
              </constraints>
              <rules>
                <rule id="cb0c-0852-6499-736e" name="Armoury Assets" hidden="false">
                  <description>Upgrade 1-2 units in this formation: Land Raider Phobos or Land Raider Proteus to Land Raider Achilles (+25 pts each); Vindicator to Vindicator Laser Destroyer (+20 pts each); Predator to Predator Infernus (+20 pts each); Predator to Predator Executioner (+20 pts each); Predator to Whirlwind Scorpius (+20 pts each). Once this upgrade is taken, the upgraded units appear in the Heavy Transport upgrade and the Tank upgrade, next to the units they replace; pick them there.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup id="b19a-866e-b912-b284" name="Heavy Transport / Teleport / Assault Ram" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6885-6876-8f7e-5107" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="d8d5-3f44-1971-ec36" name="Heavy Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f04d-b674-c185-ec3e" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="cde0-0277-1a35-53ad" name="Heavy Transport" hidden="false">
                      <description>Add enough transports to carry the entire formation. Land Raiders carry 2 Tactical-sized units or 1 Terminator, Spartans twice that and Mastodons four times (Dreadnoughts count as Terminators); the count is set from the formation.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="fe39-a834-7593-6213" name="Transport" hidden="false" collective="false" import="true" defaultSelectionEntryId="9ec6-11bb-4620-17ed">
                      <constraints>
                        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f426-aabc-93d9-7c37" type="min"/>
                        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4639-7d57-f2bc-79cb" type="max"/>
                      </constraints>
                      <selectionEntries>
                        <selectionEntry id="9ec6-11bb-4620-17ed" name="Land Raider Phobos" hidden="false" collective="false" import="true" type="upgrade">
                          <constraints>
                            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f2ae-d1a5-9dfc-f650" type="max"/>
                          </constraints>
                          <selectionEntryGroups>
                            <selectionEntryGroup id="e5f4-71e2-361a-6fa9" name="Transports" hidden="false" collective="false" import="true" defaultSelectionEntryId="f009-8fb5-f3c7-9e99">
                              <modifiers>
                                <modifier type="increment" field="d073-9511-5e19-242a" value="1">
                                  <repeats>
                                    <repeat field="f52a-9ea6-2bb3-2a37" scope="e0d9-a742-05ec-cbb6" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="any" repeats="1" roundUp="true"/>
                                  </repeats>
                                </modifier>
                                <modifier type="increment" field="e9d4-7a71-86f0-c9f5" value="1">
                                  <repeats>
                                    <repeat field="f52a-9ea6-2bb3-2a37" scope="e0d9-a742-05ec-cbb6" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="any" repeats="1" roundUp="true"/>
                                  </repeats>
