            <selectionEntry id="3363-72d3-46b7-cddc" name="Armoury Assets" hidden="false" collective="false" import="true" type="upgrade">
              <modifiers>
                <modifier type="set" field="16b0-ea20-2415-6767" value="0">
                  <conditions>
                    <condition field="selections" scope="bca8-f5d0-fa6c-c1a8" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1c1a-168c-d3cf-3310" type="lessThan"/>
                  </conditions>
                </modifier>
              </modifiers>
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="16b0-ea20-2415-6767" type="max"/>
              </constraints>
              <rules>
                <rule id="1a96-70c2-c615-256d" name="Armoury Assets" hidden="false">
                  <description>Upgrade 1-2 units in this formation: Land Raider Phobos or Land Raider Proteus to Land Raider Achilles (+25 pts each); Vindicator to Vindicator Laser Destroyer (+20 pts each); Predator to Predator Infernus (+20 pts each); Predator to Predator Executioner (+20 pts each); Predator to Whirlwind Scorpius (+20 pts each). Once this upgrade is taken, the upgraded units appear in the Heavy Transport upgrade and the Tank upgrade, next to the units they replace; pick them there.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup id="58a9-0090-a89a-bb46" name="Standard Transport / Drop Assault / Heavy Transport / Assault Claw" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ee01-ab60-eff4-7724" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="afc3-5ebf-b6a6-63b1" name="Standard Transport" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b041-5416-7523-4400" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="8a8b-9634-0910-b1b5" name="Standard Transport" hidden="false">
                      <description>Add enough Rhino Armoured Carriers to transport the entire formation after all other upgrades are chosen. Each Rhino carries 2 Tactical-sized units; one of them may be a Damocles Command Rhino. The count is set from the formation; add this upgrade last, or adjust the transports if you change units afterwards.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="1334-7d80-8d3f-7cfe" name="Transports" hidden="false" collective="false" import="true" defaultSelectionEntryId="a669-03a8-5782-9a09">
                      <modifiers>
                        <modifier type="increment" field="f7b5-43dd-6a69-b8be" value="1">
