  <selectionEntries>
    <selectionEntry id="9a1c-91e0-c2a4-770b" name="Legion" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="10b7-dd2b-c998-309a" type="min"/>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f66f-99ea-e4ac-db7d" type="max"/>
      </constraints>
      <categoryLinks>
        <categoryLink id="7487-00fe-a8aa-a658" name="Configuration" hidden="false" targetId="ba14-d0f1-f942-df54" primary="true"/>
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup id="29b8-2bde-2ae6-6465" name="Legion" hidden="false" collective="false" import="true" defaultSelectionEntryId="a31f-fb56-34fd-a2a8">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c36d-545d-cade-f316" type="min"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c923-77b9-fac8-4f01" type="max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="a31f-fb56-34fd-a2a8" name="None (core list)" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a46e-1dcc-743b-6376" type="max"/>
              </constraints>
              <rules>
                <rule id="418c-1c4c-afc8-b0cc" name="Core list" hidden="false">
                  <description>The core Legion list, with no unique Legion.
Cohesive allies: Legio Titanicus.
Disruptive allies: Daemons Of The Ruinstorm, Imperial Militia, Solar Auxilia, Knight Household, Mechanicum Taghmata.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="8c12-0ae4-5955-1a0c" name="Iron Hands" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fd86-25ab-b40e-152c" type="max"/>
              </constraints>
              <rules>
                <rule id="076c-b327-cfb2-4508" name="Iron Hands" hidden="false">
                  <description>Loyalist Legion.
Adds: Legion Predator Detachment; Legion Terminator Detachment; Destroyer Detachment; Medusan Immortals Squad; Legion Super Heavy Tank Squadron; Ferrus Manus, the Bane of Asirnoth.
Replaces or removes the core Legion Terminator Detachment; Legion Destroyer Detachment.
Cohesive allies: Legio Titanicus, Mechanicum Taghmata, Knight Household, Legio Custodes.
Disruptive allies: Imperial Militia, Solar Auxilia.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="2960-0f21-d19b-52e1" name="Raven Guard" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="da83-35ba-084d-693d" type="max"/>
              </constraints>
              <rules>
                <rule id="9a29-1b6a-42c3-01e5" name="Raven Guard" hidden="false">
                  <description>Loyalist Legion.
Adds: Destroyer Detachment; Dark Fury Squad; Mor Deythan Strike Detachment; Legion Storm Eagle Attack Wing; Corvus Corax, the Shadow Lord.
Replaces or removes the core Legion Destroyer Detachment; Legion Storm Eagle Attack Wing.
Cohesive allies: Legio Custodes.
Disruptive allies: Imperial Militia, Solar Auxilia, Knight Household, Mechanicum Taghmata, Legio Titanicus.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="77a9-c6f5-a8a7-eec3" name="Salamanders" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="20a3-f334-82d1-88ec" type="max"/>
              </constraints>
              <rules>
                <rule id="8a01-901a-02b9-ecbd" name="Salamanders" hidden="false">
                  <description>Loyalist Legion.
Adds: Legion Terminator Detachment; Pyroclast Detachment; Vulkan, the Promethean Fire.
Replaces or removes the core Legion Terminator Detachment.
Cohesive allies: Solar Auxilia, Legio Titanicus, Legio Custodes.
Disruptive allies: Imperial Militia, Knight Household, Mechanicum Taghmata.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="f4fc-64a1-61d7-7b4e" name="Ultramarines" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c62b-e884-ebf9-dede" type="max"/>
              </constraints>
              <rules>
                <rule id="c026-8101-71ee-2fe5" name="Ultramarines" hidden="false">
                  <description>Loyalist Legion.
Adds: Destroyer Detachment; Fulmentarus Strike Detachment; Locutarus Assault Detachment; Invictarus Suzerain Detachment; Roboute Guilliman, Master of Ultramar.
Replaces or removes the core Legion Destroyer Detachment.
Cohesive allies: Imperial Militia, Solar Auxilia, Knight Household, Mechanicum Taghmata, Legio Titanicus, Legio Custodes.
Disruptive allies: none.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="2784-14f1-b9c1-f3fd" name="Imperial Fists" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6832-ecd5-a162-ced3" type="max"/>
              </constraints>
              <rules>
                <rule id="ce67-2d7a-8f1d-44c0" name="Imperial Fists" hidden="false">
                  <description>Loyalist Legion.
Adds: Destroyer Detachment; Phalanx Warder Detachment; Templar Brethren Detachment; Castellum Stronghold; Primus Redoubt; Legion Super Heavy Tank Squadron; Rogal Dorn, Praetorian of Terra.
Replaces or removes the core Legion Destroyer Detachment.
Cohesive allies: Imperial Militia, Solar Auxilia, Knight Household, Mechanicum Taghmata, Legio Titanicus, Legio Custodes.
Disruptive allies: none.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="31c9-9941-e55d-7f69" name="Blood Angels" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fd93-67bb-1af3-51a8" type="max"/>
              </constraints>
              <rules>
                <rule id="832e-b836-a9f1-3c2f" name="Blood Angels" hidden="false">
                  <description>Loyalist Legion.
Adds: Dawnbreaker Cohort; The Angels Tears; Crimson Paladins; Sanguinius, the Angel.
Cohesive allies: Mechanicum Taghmata, Legio Titanicus, Legio Custodes.
Disruptive allies: Imperial Militia, Solar Auxilia, Knight Household.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="9c2a-a7e1-c337-16d0" name="Dark Angels" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4bad-873a-b7ad-c87e" type="max"/>
              </constraints>
              <rules>
                <rule id="4de5-2544-ca13-faf1" name="Dark Angels" hidden="false">
                  <description>Loyalist Legion.
Adds: Destroyer Detachment; Legion Super Heavy Tank Squadron; Dreadwing Interemptor Detachment; Lion El'Johnson, the Son of the Forest.
Replaces or removes the core Legion Destroyer Detachment.
Cohesive allies: Legio Titanicus, Solar Auxilia, Legio Custodes.
Disruptive allies: Imperial Militia, Knight Household, Mechanicum Taghmata.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="ddaf-54e6-e5ea-4b3a" name="White Scars" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1189-44d6-631c-5ef3" type="max"/>
              </constraints>
              <rules>
                <rule id="9abb-f268-0a4d-ba48" name="White Scars" hidden="false">
                  <description>Loyalist Legion.
Adds: Destroyer Detachment; Chogorian Brotherhood; Legion Javelin Attack Squadron; Ebon Keshig; Jaghatai Khan, the Great Khan.
Replaces or removes the core Legion Destroyer Detachment; Legion Javelin Attack Squadron.
Cohesive allies: Legio Titanicus, Solar Auxilia, Mechanicum Taghmata, Knight Household, Legio Custodes.
Disruptive allies: Imperial Militia.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="5abe-114a-26c1-466f" name="Space Wolves" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8e43-b4cd-69b0-9930" type="max"/>
              </constraints>
              <rules>
                <rule id="bf9b-eeca-cdb5-61a1" name="Space Wolves" hidden="false">
                  <description>Loyalist Legion.
Adds: Grey Slayer Warband; Deathsworn Warband; Wolf Guard Detachment; Leman Russ, the Wolf King.
Uses its own version of the Centurion upgrade.
Cohesive allies: Legio Titanicus, Legio Custodes.
Disruptive allies: Imperial Militia, Solar Auxilia, Mechanicum Taghmata, Knight Household.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="67af-3dc9-dcc5-5a09" name="Night Lords" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="05ec-4750-3b17-150b" type="max"/>
              </constraints>
              <rules>
                <rule id="3bdc-cd5c-7712-749a" name="Night Lords" hidden="false">
                  <description>Traitor Legion.
Adds: Night Raptor Squad; Terror Detachment; Destroyer Detachment; Konrad Curze, The Night Haunter.
Replaces or removes the core Legion Destroyer Detachment.
Cohesive allies: Legio Titanicus.
Disruptive allies: Daemons Of The Ruinstorm, Imperial Militia, Solar Auxilia, Knight Household, Mechanicum Taghmata.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="ed81-5eba-378d-f468" name="World Eaters" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1e1b-b804-af6e-54bd" type="max"/>
              </constraints>
              <rules>
                <rule id="bea4-17d5-299f-38f4" name="World Eaters" hidden="false">
                  <description>Traitor Legion.
Adds: Destroyer Detachment; Rampager Detachment; Red Butchers Detachment; Angron, Master of the World Eaters.
Replaces or removes the core Legion Destroyer Detachment.
Cohesive allies: Legio Titanicus, Daemons Of The Ruinstorm (Khorne).
Disruptive allies: Imperial Militia, Solar Auxilia, Knight Household, Mechanicum Taghmata.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="ab43-04ff-c709-418a" name="Emperor's Children" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c2f4-793b-a67f-f0a7" type="max"/>
              </constraints>
              <rules>
                <rule id="c54e-ed79-366e-4076" name="Emperor's Children" hidden="false">
                  <description>Traitor Legion.
Adds: Palatine Blades Detachment; Kakophoni Detachment; Phoenix Terminator Detachment; Fulgrim, the Illuminator.
Cohesive allies: Legio Titanicus, Daemons Of The Ruinstorm (Slaanesh).
Disruptive allies: Imperial Militia, Solar Auxilia, Knight Household, Mechanicum Taghmata.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="929b-f278-b553-b154" name="Iron Warriors" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a73e-176e-257c-abd8" type="max"/>
              </constraints>
              <rules>
                <rule id="b2e5-7304-ba92-d37a" name="Iron Warriors" hidden="false">
                  <description>Traitor Legion.
Adds: Legion Land Raider Battle Squadron; Iron Havoc Detachment; Legion Terminator Detachment; Legion Artillery Battery; Perturabo, Primarch of the Iron Warriors; Legion Super Heavy Tank Squadron.
Replaces or removes the core Legion Terminator Detachment; Legion Artillery Battery.
Cohesive allies: Legio Titanicus, Mechanicum Taghmata.
Disruptive allies: Daemons Of The Ruinstorm, Imperial Militia, Solar Auxilia, Knight Household.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="1db9-27ae-2ec8-2216" name="Death Guard" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="496f-a127-3bcd-7333" type="max"/>
              </constraints>
              <rules>
                <rule id="11fa-a174-48cf-7cdc" name="Death Guard" hidden="false">
                  <description>Traitor Legion.
Adds: Destroyer Detachment; Legion Terminator Detachment; Deathshroud Terminator Detachment; Mortarion, the Pale King.
Replaces or removes the core Legion Terminator Detachment; Legion Assault Marine Detachment; Legion Destroyer Detachment.
A Death Guard army cannot take a Legion Assault Marine Detachment as a Line Detachment.
Cohesive allies: Legio Titanicus, Daemons Of The Ruinstorm (Nurgle).
Disruptive allies: Mechanicum Taghmata, Imperial Militia, Solar Auxilia, Knight Household.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="e523-7626-c881-2fb9" name="Word Bearers" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="17ca-9041-8b13-56e4" type="max"/>
              </constraints>
              <rules>
                <rule id="55d6-1aee-5261-4ac0" name="Word Bearers" hidden="false">
                  <description>Traitor Legion.
Adds: Destroyer Detachment; Gal Vorbak Dark Brethren; Ashen Circle Detachment; Legion Contemptor Dreadnought Talon; Lorgar, the Voice of Truth.
Replaces or removes the core Legion Destroyer Detachment; Legion Contemptor Dreadnought Talon.
Cohesive allies: Daemons Of The Ruinstorm, Imperial Militia (Traitor Militia).
Disruptive allies: Legio Titanicus, Mechanicum Taghmata, Knight Household, Solar Auxilia.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry id="56f6-26b4-2d57-b99e" name="Sons of Horus" hidden="false" collective="false" import="true" type="upgrade">
