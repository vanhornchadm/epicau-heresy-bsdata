              <rules>
                <rule id="7e90-2a13-81e6-cffd" name="Armoury Assets" hidden="false">
                  <description>Upgrade 1-2 units in this formation: Land Raider Phobos or Land Raider Proteus to Land Raider Achilles (+25 pts each). Once this upgrade is taken, the upgraded units appear in the Heavy Transport upgrade, next to the units they replace; pick them there.</description>
                </rule>
              </rules>
