              </constraints>
              <rules>
                <rule id="d025-33d4-5e90-d0d9" name="Armoury Assets" hidden="false">
                  <description>Upgrade 1-2 units in this formation: Land Raider Phobos or Land Raider Proteus to Land Raider Achilles (+25 pts each); Vindicator to Vindicator Laser Destroyer (+20 pts each); Predator to Predator Infernus (+20 pts each); Predator to Predator Executioner (+20 pts each); Predator to Whirlwind Scorpius (+20 pts each). Once this upgrade is taken, the upgraded units appear in the Heavy Transport upgrade and the Tank upgrade, next to the units they replace; pick them there.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup id="b0c0-e1a0-761c-7717" name="Assault Ram / Heavy Transport / Teleport" hidden="false" collective="false" import="true">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f2de-b9d3-bf7f-ade3" type="max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry id="0779-bf69-5171-bcea" name="Assault Ram" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fbe5-6363-048b-eb77" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="b64a-e8c8-2e6c-de05" name="Assault Ram" hidden="false">
                      <description>Add enough Caestus Assault Rams to transport the entire formation. Each carries 2 Breacher or Terminator units; the count is set from the formation.</description>
                    </rule>
                  </rules>
                  <selectionEntryGroups>
                    <selectionEntryGroup id="c8fa-97f3-0f2f-4229" name="Transports" hidden="false" collective="false" import="true" defaultSelectionEntryId="c255-cd0e-fc52-b064">
                      <modifiers>
                        <modifier type="increment" field="a7a2-d712-518c-21d5" value="1">
                          <repeats>
                            <repeat field="9b58-ba34-d974-341c" scope="0c7e-9eff-02ad-a8c4" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="any" repeats="1" roundUp="true"/>
