      <description>May not take a March action.</description>
    </rule>
    <rule id="01d8-3d55-bd48-da66" name="Transport (Mechanicum Land Raider)" hidden="false">
      <description>May carry 1 Thallax, Ursarax or Myrmidon unit OR 2 of the following units: Tech Thrall, Tech Priest, Scyllax A Mechanicum Land Raider is armed with Twin Lascannons OR Flamestorm Cannons OR Twin Multi-Meltas, choose which weapon before the game.</description>
    </rule>
    <rule id="adf8-ebb6-3b80-1887" name="Transport (Triaros Armoured Conveyor)" hidden="false">
      <description>May carry 2 Thallax, Ursarax or Myrmidon unit OR 4 of the following units: Tech Thrall, Tech Priest, Scyllax.</description>
    </rule>
  </sharedRules>
