    <rule id="5902-4d9a-c267-1f1c" name="Critical Hit (Falchion)" hidden="false">
      <description>This unit is destroyed and all units within 5cm of the Falchion suffer a standard hit on a 6+.</description>
    </rule>
    <rule id="11b4-7293-cd5f-c812" name="Critical Hit (Ordinatus Majoris)" hidden="false">
      <description>The Ordinatus is destroyed. All units within 15cm suffer a hit on a 5+. All friendly formations within line of sight take a Blast Marker.</description>
    </rule>
    <rule id="6c2a-d7a4-943e-52fb" name="Critical Hit (Ordinatus Minoris)" hidden="false">
      <description>The Ordinatus is destroyed. All units within 15cm suffer a standard hit on a 5+.</description>
