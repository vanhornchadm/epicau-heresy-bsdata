<catalogue id="f2de-6bf1-7172-6576" name="EpicAU - Mechanicum Taghmata" revision="1" battleScribeVersion="2.03" authorName="EpicAU Horus Heresy (community) - BSData conversion" authorContact="" authorUrl="https://web.archive.org/web/20201111221247/http://epicau.com/mw/index.php/Main_Page" library="false" gameSystemId="5924-e3fb-5543-3044" gameSystemRevision="1" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <forceEntries>
    <forceEntry id="f42c-88fc-997a-1cc8" name="Mechanicum Taghmata" hidden="false">
      <rules>
        <rule id="4f89-486f-3232-416d" name="Army List" hidden="false">
          <description>Strategy Rating 3. Formation initiative 2+.
3 Support Detachments may be taken per Line Detachment.
A detachment may choose up to four upgrades, each only once, and only one transport option.
Up to 1/3 of the army's points may be spent on Allies or Lords of War.
Only one Archmagos Prime may be included in the army.
Cohesive allies: Legion Astartes, Knight Household, Legio Titanicus.
Disruptive allies: Imperial Militia, Solar Auxilia.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="8c69-7dc0-fa6b-a866" name="Allies" hidden="false" targetId="d6db-799f-23f8-2194" type="rule"/>
