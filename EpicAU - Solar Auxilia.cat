  <sharedRules>
    <rule id="6440-4ee2-b83e-9825" name="Critical Hit (Baneblade)" hidden="false">
      <description>The unit is destroyed. All units within 5cm take a standard hit on a 6+.</description>
    </rule>
    <rule id="4097-3f45-4838-92fc" name="Critical Hit (Dracosan Armoured Transport)" hidden="false">
      <description>The unit is destroyed. All units within 5cm take a standard hit on a 6+.</description>
    </rule>
    <rule id="2940-c983-1d20-50b7" name="Critical Hit (Shadowsword)" hidden="false">
      <description>The unit is destroyed. All units within 5cm take a standard hit on a 6+.</description>
    </rule>
    <rule id="5281-6d3a-0476-2595" name="Critical Hit (Stormblade)" hidden="false">
      <description>The unit is destroyed. All units within 5cm take a standard hit on a 6+.</description>
    </rule>
    <rule id="e8cd-3ee7-c689-0648" name="Critical Hit (Stormhammer)" hidden="false">
      <description>The unit is destroyed. All units within 5cm take a standard hit on a 6+.</description>
    </rule>
    <rule id="82a5-28fc-ce4a-a34e" name="Critical Hit (Stormlord)" hidden="false">
      <description>The unit is destroyed. All units within 5cm take a standard hit on a 6+.</description>
    </rule>
    <rule id="4679-f808-45ba-e553" name="Critical Hit (Stormsword)" hidden="false">
      <description>The unit is destroyed. All units within 5cm take a standard hit on a 6+.</description>
    </rule>
    <rule id="d358-e95d-e878-acc8" name="Transport (Arvus Lighter Orbital Shuttle)" hidden="false">
      <description>May carry two infantry units (Ogryn Charonite and Rapier Platforms take up two spaces each).</description>
    </rule>
    <rule id="dd1c-f5bb-820d-ce22" name="Transport (Dauntless Class Light Cruiser)" hidden="false">
      <description>May carry up to 20 of the following units and as many Arvus Lighter Orbital Shuttles required to transport them: Lord Marshall, Solar Auxlia Command Section, Solar Auxilia Infantry Section, Solar Auxilia Close Support Section, Veletaris Storm, Ogryn Charonite Squad or Rapier Platforms.</description>
    </rule>
    <rule id="4d08-1162-2485-c953" name="Transport (Dracosan Armoured Transport)" hidden="false">
      <description>May carry four infantry units. Ogryn Charonites take up two spaces.</description>
    </rule>
    <rule id="da00-95b7-b75b-5a65" name="Transport (Emperor Class Battleship)" hidden="false">
      <description>May carry up to 60 of the following units and as many Arvus Lighter Orbital Shuttles required to transport them: Lord Marshall, Solar Auxlia Command Section, Solar Auxilia Infantry Section, Solar Auxilia Close Support Section, Veletaris Storm, Ogryn Charonite Squad or Rapier Platforms.</description>
    </rule>
    <rule id="723b-30dd-7d67-71f9" name="Transport (Stormlord)" hidden="false">
      <description>May carry 8 infantry units (Ogryns take up two spaces each). Additionally, up to 4 units being transported may fire and/or use their FF values during an assault.</description>
    </rule>
    <rule id="0dad-7cea-ea75-a306" name="Weapon Options (Solar Auxilia Rapier Platform)" hidden="false">
      <description>A Solar Auxilia Rapier platform must select one weapon system before the start of the game. All platforms in a single detachment must select the same weapon system.</description>
    </rule>
    <rule id="572a-a391-077c-304a" name="Weapon Options (Veletaris Storm Section)" hidden="false">
      <description>Veletaris Storm Sections are all armed with either Volkite Chargers OR Power Axes, choose one option before the game.</description>
    </rule>
    <rule id="5fd5-93e1-2791-3878" name="Weapons (Dauntless Class Light Cruiser)" hidden="false">
      <description>Weapon lines are combined; check the wiki sheet.</description>
    </rule>
    <rule id="d44c-e9a6-768c-592a" name="Weapons (Solar Auxilia Close Support Section)" hidden="false">
      <description>Weapon lines are combined; check the wiki sheet.</description>
    </rule>
  </sharedRules>
