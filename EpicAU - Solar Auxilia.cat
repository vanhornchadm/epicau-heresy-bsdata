  <forceEntries>
    <forceEntry id="4bed-a77c-ebab-1136" name="Solar Auxilia" hidden="false">
      <rules>
        <rule id="f4ba-9e0e-f0df-c6e4" name="Army List" hidden="false">
          <description>Strategy Rating 3. Formation initiative 2+.
2 Support Detachments may be taken per Line Detachment.
Each detachment may purchase up to three upgrades, each only once.
Up to 1/3 of the army's points may be spent on Allies or Lords of War.
Cohesive allies: Legio Titanicus, Legion Astartes, Knight Household.
Disruptive allies: Mechanicum Taghmata, Daemons Of The Ruinstorm.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="8b86-a763-bda7-01e6" name="Allies" hidden="false" targetId="d6db-799f-23f8-2194" type="rule"/>
